{
  "name": "buildnet-directory",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "dev:server": "node server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:backend": "echo 'Backend uses ES modules, no build needed'",
    "preview": "vite preview --host :: --port 3000",
    "start": "node server/server.js",
    "start:server": "node server/server.js",
    "test:api": "curl http://localhost:5000/health",
    "deploy:frontend": "npm run build:frontend && gcloud storage rm -r gs://buildnetdirectory/** && gcloud storage rsync ./dist gs://buildnetdirectory --recursive",
    "deploy:backend": "cd server && gcloud run deploy buildnet-backend --source . --region us-central1 --allow-unauthenticated --port 5000",
    "deploy:all": "npm run deploy:backend && npm run deploy:frontend"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@google/generative-ai": "^0.21.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "2.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^0.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^12.6.0",
    "framer-motion": "^10.16.4",
    "googleapis": "^165.0.0",
    "lucide-react": "^0.285.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.16.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/generator": "^7.27.0",
    "@babel/parser": "^7.27.0",
    "@babel/traverse": "^7.27.0",
    "@babel/types": "^7.27.0",
    "@types/node": "^20.8.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "terser": "^5.39.0",
    "vite": "^4.4.5",
    "firebase": "^10.7.0"

  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
